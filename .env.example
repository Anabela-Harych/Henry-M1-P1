# Identificá ambos modelos para poder compararlos sobre los mismos casos.
MODEL_A_PROVIDER= openai
MODEL_A_NAME= gpt-6-luna
MODEL_B_PROVIDER= gemini
MODEL_B_NAME= gemini-3.6-flash

# Completá solo las claves de los proveedores que vayas a usar.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Límites de cada llamada y ubicación del registro de uso.
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_MAX_OUTPUT_TOKENS=256
GEMINI_THINKING_LEVEL=minimal
LLM_USAGE_LOG_PATH=data/reports/llm_usage.jsonl
LLM_PROMPT_PATH=prompts/v1_zero_shot.yaml

# Opcional: precios en USD por millón de tokens. Vacíos = tarifa de referencia del código.
# Revisá y actualizá estos valores al cambiar de modelo, plan o tarifa del proveedor.
OPENAI_INPUT_USD_PER_MILLION_TOKENS=
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=
GEMINI_INPUT_USD_PER_MILLION_TOKENS=
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=

